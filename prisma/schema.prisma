generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REPORTED
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  KONTIGO
  CASH_COP
  CASH_USD
  CASH_ON_DELIVERY
}

enum Currency {
  COP
  USD
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String?      @unique
  password      String?
  phone         String?      @unique
  otpCode       String?
  otpExpiry     DateTime?
  role          Role         @default(CLIENT)
  orders        Order[]
  stockRequests StockRequest[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Product {
  id                    String         @id @default(cuid())
  name                  String
  slug                  String         @unique
  description           String
  price                 Float          // Base price (usually COP or USD depending on default)
  priceUSD              Float?         // Explicit USD price
  stock                 Int            @default(0)
  isPreorder            Boolean        @default(false)
  arrivalDate           DateTime?
  estimatedDeliveryDate DateTime?
  category              Category       @relation(fields: [categoryId], references: [id])
  categoryId            String
  images                ProductImage[]
  orderItems            OrderItem[]
  stockAlerts           StockAlert[]
  stockRequests         StockRequest[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Order {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  currency      Currency      @default(COP)
  total         Float
  isPreorder        Boolean       @default(false)
  address           String
  notes             String?
  paymentReference  String?
  paymentReportedAt DateTime?
  items             OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String  // Snapshot of product name
  quantity  Int
  price     Float   // Snapshot of price in the chosen currency
}

model StockAlert {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
}

model StockRequest {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  message   String?
  status    String   @default("PENDING") // PENDING, FULFILLED, etc.
  createdAt DateTime @default(now())
}
